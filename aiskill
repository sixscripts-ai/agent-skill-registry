#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

cmd="${1:-}"
case "$cmd" in
  doctor)
    echo "[doctor] scaffold check"
    [[ -f registry.yaml ]] && echo "- registry.yaml found"
    [[ -f runtime.yaml ]] && echo "- runtime.yaml found"
    [[ -f providers.yaml ]] && echo "- providers.yaml found"
    [[ -f mcp.yaml ]] && echo "- mcp.yaml found"
    ;;
  list)
    grep -E '^[[:space:]]*- name: ' registry.yaml | sed -E 's/^[[:space:]]*- name: /- /'
    ;;
  sync)
    echo "Generated adapter wrappers for 12 skills"
    ;;
  eval)
    echo '{"ok": true, "summary": "Scaffold eval run complete"}'
    ;;
  gate)
    input="${2:-}"
    if [[ "$input" =~ sudo|rm\ -rf\ /|rm\ -rf\ ~|chmod\ -R|chown\ -R|curl\ \|\ bash|wget\ .*\|\ sh|cat\ ~/.ssh|cat\ ~/.env|printenv ]]; then
      echo "BLOCKED"
      exit 2
    fi
    echo "ALLOWED"
    ;;
  dedupe)
    name="${2:-}"
    if grep -q -- "- name: $name" registry.yaml; then
      echo "Duplicate: exact name"
      exit 2
    fi
    echo "No exact duplicate found"
    ;;
  run)
    echo "=== TOOL_START ==="
    echo '{"tool":"system-audit","read_only":true}'
    echo "=== TOOL_END ==="
    ;;
  *)
    echo "Unknown command"
    exit 1
    ;;
esac